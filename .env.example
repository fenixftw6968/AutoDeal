# AutoDeal Environment Variables Template
# Copy this file to .env and adjust variables as required.

# Server Configuration
PORT=8080

# Persistent Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017/autodeal

# In-Memory Cache (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & JWT
JWT_SECRET=AutoDealUltraSecureSuperSecretKeyForJwtSigningMustBeAtLeast256BitsLong2026
JWT_EXPIRATION_MS=86400000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost
